{
  "name": "facts-monorepo",
  "version": "0.1.3",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.3.4"
  },
  "scripts": {
    "check": "pnpm typecheck && pnpm format:check && pnpm facts:check",
    "facts:check": "pnpm -r exec fact-kit check",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "pnpm -r build",
    "test": "vitest run",
    "snapshot": "bash scripts/release/snapshot.sh"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "fact-kit": "^0.10.0",
    "prettier": "^3.6.2",
    "semver": "^7.8.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
