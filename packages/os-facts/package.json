{
  "name": "os-facts",
  "version": "0.1.0",
  "description": "Unofficial machine-readable facts about operating systems and their service managers: launchd. Not affiliated with Apple or any operating system vendor.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/carlos-space/facts",
    "directory": "packages/os-facts"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "fact-kit build"
  },
  "devDependencies": {
    "fact-kit": "^0.10.0",
    "launchd-facts": "workspace:*"
  },
  "exports": {
    "./launchd/index.json": "./dist/launchd/index.json",
    "./launchd/schemas/*": "./dist/launchd/schemas/*"
  }
}
