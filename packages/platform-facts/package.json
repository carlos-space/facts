{
  "name": "platform-facts",
  "version": "0.2.0",
  "description": "Unofficial machine-readable facts about third-party developer tools. Not affiliated with Anthropic, OpenAI, GitHub, Apple, Cloudflare or the Sparkle project.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/carlos-space/facts",
    "directory": "packages/platform-facts"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "files": [
    "dist",
    "LICENSE",
    "LICENSE-APACHE-2.0",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "node ../fact-kit/src/bin.ts build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate:observed": "node scripts/migrate-observed.ts",
    "compare:migration": "node scripts/compare-migration.ts",
    "convert": "node scripts/convert-claude-code.ts && node scripts/convert-github.ts && node scripts/convert-pnpm.ts && node scripts/convert-codex.ts",
    "convert:claude-code": "node scripts/convert-claude-code.ts",
    "convert:codex": "node scripts/convert-codex.ts",
    "convert:github": "node scripts/convert-github.ts",
    "convert:pnpm": "node scripts/convert-pnpm.ts",
    "probe:hooks": "node probes/claude-code-hooks/run.ts"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.308",
    "ajv": "^8.20.0"
  },
  "exports": {
    "./app-store/index.json": "./dist/app-store/index.json",
    "./claude-code/index.json": "./dist/claude-code/index.json",
    "./claude-desktop/index.json": "./dist/claude-desktop/index.json",
    "./codex/index.json": "./dist/codex/index.json",
    "./crates-io/index.json": "./dist/crates-io/index.json",
    "./fact-kit/index.json": "./dist/fact-kit/index.json",
    "./git/index.json": "./dist/git/index.json",
    "./github/index.json": "./dist/github/index.json",
    "./google-play/index.json": "./dist/google-play/index.json",
    "./npm/index.json": "./dist/npm/index.json",
    "./pnpm/index.json": "./dist/pnpm/index.json",
    "./pypi/index.json": "./dist/pypi/index.json",
    "./release-please/index.json": "./dist/release-please/index.json",
    "./typescript/index.json": "./dist/typescript/index.json",
    "./apple-notarization/index.json": "./dist/apple-notarization/index.json",
    "./cloudflare-r2/index.json": "./dist/cloudflare-r2/index.json",
    "./sparkle/index.json": "./dist/sparkle/index.json"
  }
}
