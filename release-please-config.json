{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "$comment": "Two components released together on one release train: a release/vX.Y branch carries the whole repository, cut-release.sh --units picks the packages that board it, and scoped to the train this config holds only those. separate-pull-requests is false so the train gets a single Release PR with one changelog per package; fact-kit and platform-facts still keep separate versions and tags. Nothing is released from main.",
  "include-component-in-tag": true,
  "include-v-in-tag": true,
  "tag-separator": "/",
  "separate-pull-requests": false,
  "bump-minor-pre-major": true,
  "initial-version": "0.1.0",
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Added"
    },
    {
      "type": "fix",
      "section": "Fixed"
    },
    {
      "type": "perf",
      "section": "Changed"
    },
    {
      "type": "deps",
      "section": "Changed"
    },
    {
      "type": "revert",
      "section": "Changed"
    }
  ],
  "packages": {
    "packages/fact-kit": {
      "component": "fact-kit",
      "release-type": "node",
      "initial-version": "0.1.0-alpha.1"
    },
    "packages/platform-facts": {
      "component": "platform-facts",
      "release-type": "node",
      "initial-version": "0.1.0-alpha.1"
    }
  },
  "plugins": [],
  "versioning": "prerelease",
  "prerelease-type": "alpha.1",
  "prerelease": true,
  "last-release-sha": "83a70c326c185e7f2a09718b3c98ed7926ffd51b"
}
