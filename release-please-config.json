{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "$comment": "Two components, one version line each, released straight from main. separate-pull-requests is true because fact-kit (tooling) and platform-facts (data) change for unrelated reasons: a fact edit must not wait on, or force a version bump of, the tool, and each Release PR then carries one changelog.",
  "include-component-in-tag": true,
  "include-v-in-tag": true,
  "tag-separator": "/",
  "separate-pull-requests": true,
  "bump-minor-pre-major": true,
  "initial-version": "0.1.0",
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Added"
    },
    {
      "type": "fix",
      "section": "Fixed"
    },
    {
      "type": "perf",
      "section": "Changed"
    },
    {
      "type": "deps",
      "section": "Changed"
    },
    {
      "type": "revert",
      "section": "Changed"
    }
  ],
  "packages": {
    "packages/platform-facts": {
      "component": "platform-facts",
      "release-type": "node"
    }
  },
  "versioning": "prerelease",
  "prerelease-type": "alpha.1",
  "prerelease": false
}
